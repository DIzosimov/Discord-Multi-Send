DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id
DISCORD_GUILD_ID=replace_with_your_server_id

# Persistent configuration is stored here.
DATA_FILE=./data/config.json

# Mentions are disabled by default to prevent accidental pings.
# Change to true if scheduled messages should ping users, roles, @here, or @everyone.
ALLOW_MENTIONS=false

# Broadcasts are silent by default: they appear normally but do not trigger
# push or desktop notifications. Change to false to restore notifications.
SILENT_BROADCASTS=true
